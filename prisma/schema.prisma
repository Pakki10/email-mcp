generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth models ---
// Standard next-auth Prisma adapter shape. Account holds the Google refresh
// token that gmail.ts uses to mint short-lived access tokens on demand.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  apiKeys      ApiKey[]
  telegram     TelegramLink?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MCP API keys ---
// Same pattern as video-render-mcp. Raw key format: `em_live_<48 hex>`.
// Only the SHA-256 hash is stored — raw shown to user exactly once.

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Telegram link ---
// One row per user who's plugged in a bot. `botToken` is the user's own bot
// token from @BotFather. `webhookSecret` is a random per-user segment we
// route their webhook URL through so a leaked bot token can't be sent to us
// via someone else's URL. `chatId` gets filled the first time the user
// messages the bot; before that it's null.

model TelegramLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  botToken      String
  botUsername   String?
  webhookSecret String   @unique
  chatId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
