# --- Required ---
DATABASE_URL="postgresql://admin:admin@db:5432/email_mcp"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3010"

# Public base URL that OAuth callbacks + Telegram webhooks point at.
# In prod set this to your https://... domain (e.g. https://email.regiq.in).
PUBLIC_BASE_URL="http://localhost:3010"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Add these scopes on the consent screen:
#   openid, email, profile,
#   https://www.googleapis.com/auth/gmail.readonly,
#   https://www.googleapis.com/auth/gmail.send
# Redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Telegram ---
# Bot token from @BotFather. Each user brings their own bot; this is the
# server-owner's fallback demo bot. Per-user tokens live in the DB.
TELEGRAM_BOT_TOKEN=""

# --- LLM (parses Telegram messages into tool calls) ---
# Get at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
